# Copy to .env and adjust as needed. .env is gitignored.
# All vars are optional for `make compose-up` — defaults target the local
# single-broker Kafka. Only fill in SASL fields when pointing at real MSK.
# See docs/SETUP.md §5a for the full reference.

INGEST_BOOTSTRAP_SERVERS=localhost:9092
INGEST_SASL_USERNAME=
INGEST_SASL_PASSWORD=
INGEST_UNIVERSE_PATH=config/universe.yaml
INGEST_VENUES=["binance", "coinbase"]
INGEST_QUEUE_MAXSIZE=20000
INGEST_TRADES_TOPIC=md.trades.v1
